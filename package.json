{
  "name": "pagewise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "智阅 PageWise - Chrome 浏览器扩展",
  "scripts": {
    "test": "node --test 'tests/*.js'",
    "test:ci": "node --test $(find tests -name 'test-*.js' -not -name 'test-e2e-*' -not -path 'tests/e2e/*' | sort)",
    "test:all": "node --test 'tests/*.js' 'tests/e2e/*.js'",
    "test:coverage": "rm -rf coverage/tmp && c8 --reporter=lcov --reporter=text-summary npm run test:ci",
    "coverage:gate": "c8 check-coverage --lines 20",
    "lint": "eslint . --max-warnings 10000"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^9.39.4"
  }
}
